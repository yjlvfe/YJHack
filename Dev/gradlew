#!/bin/sh

set -eu

APP_HOME=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
WRAPPER_JAR="$APP_HOME/gradle/wrapper/gradle-wrapper.jar"

if [ -f "$WRAPPER_JAR" ]; then
    if [ -n "${JAVA_HOME:-}" ]; then
        JAVACMD="$JAVA_HOME/bin/java"
    else
        JAVACMD=java
    fi
    exec "$JAVACMD" -Xmx64m -Xms64m -Dorg.gradle.appname=gradlew \
        -classpath "$WRAPPER_JAR" org.gradle.wrapper.GradleWrapperMain "$@"
fi

# The repository previously ignored gradle-wrapper.jar. Keep clean clones buildable while the
# standard jar is restored: prefer an installed Gradle, otherwise bootstrap the pinned release.
if command -v gradle >/dev/null 2>&1; then
    exec gradle "$@"
fi

VERSION=8.14.4
SHA256=f1771298a70f6db5a29daf62378c4e18a17fc33c9ba6b14362e0cdf40610380d
CACHE_ROOT="${GRADLE_USER_HOME:-${HOME:-$APP_HOME/.gradle}}/yjhack-wrapper"
DIST_DIR="$CACHE_ROOT/gradle-$VERSION"
ZIP="$CACHE_ROOT/gradle-$VERSION-bin.zip"
URL="https://services.gradle.org/distributions/gradle-$VERSION-bin.zip"

if [ ! -x "$DIST_DIR/bin/gradle" ]; then
    mkdir -p "$CACHE_ROOT"
    TMP="$ZIP.tmp.$$"
    trap 'rm -f "$TMP"' EXIT HUP INT TERM

    if command -v curl >/dev/null 2>&1; then
        curl --fail --location --retry 3 --silent --show-error "$URL" -o "$TMP"
    elif command -v wget >/dev/null 2>&1; then
        wget -q --tries=3 -O "$TMP" "$URL"
    else
        echo "ERROR: gradle-wrapper.jar is missing and neither curl nor wget is available." >&2
        exit 1
    fi

    if command -v sha256sum >/dev/null 2>&1; then
        printf '%s  %s\n' "$SHA256" "$TMP" | sha256sum -c - >/dev/null
    elif command -v shasum >/dev/null 2>&1; then
        ACTUAL=$(shasum -a 256 "$TMP" | awk '{print $1}')
        [ "$ACTUAL" = "$SHA256" ] || { echo "ERROR: Gradle checksum mismatch." >&2; exit 1; }
    else
        echo "ERROR: no SHA-256 verification tool is available." >&2
        exit 1
    fi

    command -v unzip >/dev/null 2>&1 || { echo "ERROR: unzip is required." >&2; exit 1; }
    rm -rf "$DIST_DIR"
    unzip -q "$TMP" -d "$CACHE_ROOT"
    mv "$TMP" "$ZIP"
    trap - EXIT HUP INT TERM
fi

exec "$DIST_DIR/bin/gradle" "$@"
