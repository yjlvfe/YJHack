{
  "schemaVersion": 1,
  "id": "yjhack",
  "version": "${version}",
  "name": "YJHack ${version}",
  "description": "YJHack - All-in-one client mod by MasterYJ",
  "authors": [
    "MasterYJ"
  ],
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.masteryj.modgui.ModGuiClient",
      "com.masteryj.tracker.TrackerClient",
      "com.masteryj.aimassist.AimAssistClient",
      "com.masteryj.autoleft.AutoLeftClient",
      "com.masteryj.autoright.AutoRightClient",
      "com.masteryj.ninjabridge.NinjaBridgeClient"
    ]
  },
  "mixins": [
    "yjhack.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "~1.21.5",
    "java": ">=21",
    "fabric-api": "*"
  }
}
